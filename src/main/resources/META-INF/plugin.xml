<idea-plugin>
    <id>com.shahryar.nuxtjstoolkit</id>
    <name>Nuxt.js Toolkit</name>
    <vendor email="shahryar.hn@gmail.com">Shahryar</vendor>

    <description><![CDATA[
        Create common Nuxt.js App Router files from Project View and Editor context menus.
        Includes TypeScript and JavaScript templates.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>JavaScript</depends>

    <idea-version since-build="262" until-build="262.*"/>

    <actions>
        <group
                id="NuxtJsTemplates"
                class="com.shahryar.nuxtjstoolkit.actions.NuxtJsTemplatesGroup"
                text="Nuxt.js"
                popup="true">
            <add-to-group group-id="NewGroup" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </group>
    </actions>

    <extensions defaultExtensionNs="com.intellij">

        <internalFileTemplate name="Component.vue"/>
        <internalFileTemplate name="Composable.ts"/>
        <internalFileTemplate name="Enum.ts"/>
        <internalFileTemplate name="Interface Type.ts"/>
        <internalFileTemplate name="Layout.vue"/>
        <internalFileTemplate name="Middleware.ts"/>
        <internalFileTemplate name="Page.vue"/>
        <internalFileTemplate name="Plugin.ts"/>
        <internalFileTemplate name="Server API.ts"/>
        <internalFileTemplate name="Server Document.ts"/>
        <internalFileTemplate name="Server Middleware.ts"/>
        <internalFileTemplate name="Server Model.ts"/>
        <internalFileTemplate name="Server Model Schema.ts"/>
        <internalFileTemplate name="Server Plugins.ts"/>
        <internalFileTemplate name="Server Route.ts"/>
        <internalFileTemplate name="Server Task.ts"/>
        <internalFileTemplate name="Server WebSocket Handler.ts"/>
        <internalFileTemplate name="Store.ts"/>
        <internalFileTemplate name="Type.ts"/>
        <internalFileTemplate name="Utility.ts"/>
        <internalFileTemplate name="Translate.ts"/>

    </extensions>
</idea-plugin>
