<idea-plugin>
    <id>com.shahryar.nuxtjstoolkit</id>
    <name>Nuxt.js Toolkit</name>
    <vendor email="shahryar.hn@gmail.com">Shahryar</vendor>

    <description><![CDATA[
        Create common Nuxt.js App Router files from Project View and Editor context menus.
        Includes TypeScript and JavaScript templates.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>JavaScript</depends>

    <idea-version since-build="262" until-build="262.*"/>

    <actions>
        <group
                id="NuxtJsTemplates"
                class="com.shahryar.nuxtjstoolkit.actions.NuxtJsTemplatesGroup"
                text="Nuxt.js"
                popup="true">
            <add-to-group group-id="NewGroup" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </group>
    </actions>

</idea-plugin>
